generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
}

model caretakerassignment {
  id                                         BigInt                          @id @default(autoincrement())
  uuid                                       String                          @unique(map: "CaretakerAssignment_uuid_key") @db.VarChar(36)
  houseId                                    BigInt
  caretakerId                                BigInt
  createdBy                                  BigInt
  createdAt                                  DateTime                        @default(now())
  expiresAt                                  DateTime?
  user_caretakerassignment_caretakerIdTouser user                            @relation("caretakerassignment_caretakerIdTouser", fields: [caretakerId], references: [id], map: "CaretakerAssignment_caretakerId_fkey")
  user_caretakerassignment_createdByTouser   user                            @relation("caretakerassignment_createdByTouser", fields: [createdBy], references: [id], map: "CaretakerAssignment_createdBy_fkey")
  house                                      house                           @relation(fields: [houseId], references: [id], map: "CaretakerAssignment_houseId_fkey")
  caretakerassignmentpermission              caretakerassignmentpermission[]

  @@index([caretakerId], map: "CaretakerAssignment_caretakerId_idx")
  @@index([createdBy], map: "CaretakerAssignment_createdBy_fkey")
  @@index([houseId], map: "CaretakerAssignment_houseId_idx")
}

model caretakerassignmentpermission {
  id                                                 BigInt              @id @default(autoincrement())
  caretakerAssignmentId                              BigInt
  permissionId                                       BigInt
  grantedBy                                          BigInt
  grantedAt                                          DateTime            @default(now())
  revokedAt                                          DateTime?
  revokedBy                                          BigInt?
  caretakerassignment                                caretakerassignment @relation(fields: [caretakerAssignmentId], references: [id], map: "CaretakerAssignmentPermission_caretakerAssignmentId_fkey")
  permission                                         permission          @relation(fields: [permissionId], references: [id], map: "CaretakerAssignmentPermission_permissionId_fkey")
  user_caretakerassignmentpermission_grantedByTouser user                @relation("caretakerassignmentpermission_grantedByTouser", fields: [grantedBy], references: [id], map: "CaretakerAssignmentPermission_grantedBy_fkey")
  user_caretakerassignmentpermission_revokedByTouser user?               @relation("caretakerassignmentpermission_revokedByTouser", fields: [revokedBy], references: [id], map: "CaretakerAssignmentPermission_revokedBy_fkey")

  @@unique([caretakerAssignmentId, permissionId], map: "CaretakerAssignmentPermission_caretakerAssignmentId_permissi_key")
  @@index([permissionId], map: "CaretakerAssignmentPermission_permissionId_fkey")
  @@index([grantedBy], map: "CaretakerAssignmentPermission_grantedBy_fkey")
  @@index([revokedBy], map: "CaretakerAssignmentPermission_revokedBy_fkey")
}

model device {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique(map: "Device_uuid_key") @db.VarChar(36)
  userId    BigInt?
  endpoint  String   @db.VarChar(1024)
  p256dh    String   @db.VarChar(512)
  auth      String   @db.VarChar(512)
  createdAt DateTime @default(now())
  user      user?    @relation(fields: [userId], references: [id], map: "Device_userId_fkey")

  @@index([userId], map: "Device_userId_idx")
}

model rent_payment {
  id               BigInt               @id @default(autoincrement())
  uuid             String?              @unique @db.VarChar(36)
  flat_id          BigInt
  renter_id        BigInt
  house_id         BigInt
  amount           Decimal              @db.Decimal(10, 2)
  due_date         DateTime             @db.Date
  paid_date        DateTime?            @db.Date
  paid_amount      Decimal?             @db.Decimal(10, 2)
  payment_method   payment_method_enum?
  transaction_id   String?              @db.VarChar(100)
  status           rent_status_enum?    @default(pending)
  late_fee_amount  Decimal?             @default(0.00) @db.Decimal(10, 2)
  notes            String?              @db.Text
  base_amount      Decimal?             @db.Decimal(10, 2)
  amenities_charge Decimal?             @db.Decimal(10, 2)
  metadata         String?              @db.LongText
  created_by       BigInt?
  created_at       DateTime?            @default(now()) @db.Timestamp(0)
  updated_at       DateTime?            @default(now()) @db.Timestamp(0)
  user             user?                @relation(fields: [created_by], references: [id])
  flat             flat                 @relation(fields: [flat_id], references: [id])
  house            house                @relation(fields: [house_id], references: [id])
  renter           renter               @relation(fields: [renter_id], references: [id])

  @@index([due_date, status], map: "idx_rent_payment_due_date")
  @@index([flat_id, status], map: "idx_rent_payment_flat_id")
  @@index([created_by], map: "rent_payment_created_by_fkey")
  @@index([house_id], map: "rent_payment_house_id_fkey")
  @@index([renter_id], map: "rent_payment_renter_id_fkey")
}

model house_expense {
  id             BigInt                @id @default(autoincrement())
  uuid           String?               @unique @db.VarChar(36)
  house_id       BigInt
  category       expense_category_enum
  amount         Decimal               @db.Decimal(10, 2)
  description    String?               @db.Text
  expense_date   DateTime              @db.Date
  paid_by        BigInt?
  payment_method payment_method_enum?
  receipt_url    String?               @db.VarChar(500)
  status         expense_status_enum?  @default(pending)
  approved_by    BigInt?
  metadata       String?               @db.LongText
  created_at     DateTime?             @default(now()) @db.Timestamp(0)
  updated_at     DateTime?             @default(now()) @db.Timestamp(0)
  approvedByUser user?                 @relation("ExpenseApprovedBy", fields: [approved_by], references: [id])
  house          house                 @relation(fields: [house_id], references: [id])
  paidByUser     user?                 @relation("ExpensePaidBy", fields: [paid_by], references: [id])

  @@index([house_id, expense_date], map: "idx_house_expense_house_id")
  @@index([approved_by], map: "house_expense_approved_by_fkey")
  @@index([paid_by], map: "house_expense_paid_by_fkey")
}

model app_fee_payment {
  id             BigInt               @id @default(autoincrement())
  uuid           String?              @unique @db.VarChar(36)
  house_owner_id BigInt
  house_id       BigInt
  amount         Decimal              @db.Decimal(10, 2)
  fee_type       fee_type_enum
  due_date       DateTime             @db.Date
  paid_date      DateTime?            @db.Date
  payment_method payment_method_enum?
  transaction_id String?              @db.VarChar(100)
  status         fee_status_enum?     @default(pending)
  invoice_url    String?              @db.VarChar(500)
  metadata       String?              @db.LongText
  created_at     DateTime?            @default(now()) @db.Timestamp(0)
  updated_at     DateTime?            @default(now()) @db.Timestamp(0)
  house          house                @relation(fields: [house_id], references: [id])
  houseOwner     user                 @relation(fields: [house_owner_id], references: [id])

  @@index([house_id], map: "app_fee_payment_house_id_fkey")
  @@index([house_owner_id], map: "app_fee_payment_house_owner_id_fkey")
}

model financial_report {
  id                   BigInt    @id @default(autoincrement())
  house_id             BigInt
  month                String?   @db.VarChar(7)
  total_rent_due       Decimal?  @db.Decimal(10, 2)
  total_rent_collected Decimal?  @db.Decimal(10, 2)
  total_expenses       Decimal?  @db.Decimal(10, 2)
  net_income           Decimal?  @db.Decimal(10, 2)
  pending_payments     Int?
  overdue_payments     Int?
  generated_at         DateTime? @default(now()) @db.Timestamp(0)
  house                house     @relation(fields: [house_id], references: [id])

  @@index([house_id], map: "financial_report_house_id_fkey")
}

model flat {
  id                  BigInt            @id @default(autoincrement())
  uuid                String            @unique(map: "Flat_uuid_key") @db.VarChar(36)
  number              String?
  metadata            String?           @db.LongText
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  name                String
  last_rent_paid_date DateTime?
  late_fee_percentage Decimal?          @default(5.00) @db.Decimal(5, 2)
  rent_amount         Decimal?          @db.Decimal(10, 2)
  rent_due_date       DateTime?
  should_pay_rent_day Int               @default(10)
  house_id            BigInt
  renter_id           BigInt?
  house               house             @relation(fields: [house_id], references: [id])
  renter              renter?           @relation(fields: [renter_id], references: [id])
  notice              notice[]
  rent_payments       rent_payment[]
  floor               Int?              @default(0)
  next_payment_date   DateTime?
  advance_payments    advance_payment[]

  @@index([house_id], map: "idx_flat_house_id")
  @@index([renter_id], map: "idx_flat_renter_id")
}

model advance_payment {
  id               BigInt                 @id @default(autoincrement())
  uuid             String                 @unique(map: "AdvancePayment_uuid_key") @db.VarChar(36)
  renter_id        BigInt
  flat_id          BigInt
  house_id         BigInt
  amount           Decimal                @db.Decimal(10, 2)
  status           advance_payment_status @default(pending)
  paid_amount      Decimal                @db.Decimal(10, 2)
  remaining_amount Decimal                @db.Decimal(10, 2)
  metadata         String?                @db.LongText
  payment_date     DateTime               @db.Date
  payment_method   payment_method_enum
  transaction_id   String?                @db.VarChar(100)
  notes            String?                @db.Text
  created_at       DateTime?              @default(now()) @db.Timestamp(0)
  updated_at       DateTime?              @default(now()) @db.Timestamp(0)

  renter renter @relation(fields: [renter_id], references: [id])
  flat   flat   @relation(fields: [flat_id], references: [id])
  house  house  @relation(fields: [house_id], references: [id])

  @@index([renter_id], map: "idx_advance_payment_renter")
  @@index([flat_id], map: "idx_advance_payment_flat")
  @@index([house_id], map: "idx_advance_payment_house")
  @@index([payment_date], map: "idx_advance_payment_date")
  @@index([status], map: "idx_advance_payment_status")
}

model house {
  id                  BigInt                @id @default(autoincrement())
  uuid                String                @unique(map: "House_uuid_key") @db.VarChar(36)
  ownerId             BigInt
  address             String
  metadata            String?               @db.LongText
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  flatCount           BigInt                @default(0)
  active              Boolean               @default(false)
  name                String                @default("Unnamed House") @db.VarChar(255)
  app_fee_payments    app_fee_payment[]
  caretakerassignment caretakerassignment[]
  financial_reports   financial_report[]
  flat                flat[]
  user                user                  @relation(fields: [ownerId], references: [id], map: "House_ownerId_fkey")
  house_expenses      house_expense[]
  notice              notice[]
  rent_payments       rent_payment[]
  advancePayments     advance_payment[]

  @@index([ownerId], map: "House_ownerId_idx")
}

model notice {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique(map: "Notice_uuid_key") @db.VarChar(36)
  houseId   BigInt?
  flatId    BigInt?
  title     String
  content   String
  locale    String   @db.VarChar(8)
  createdBy BigInt?
  createdAt DateTime @default(now())
  user      user?    @relation(fields: [createdBy], references: [id], map: "Notice_createdBy_fkey")
  flat      flat?    @relation(fields: [flatId], references: [id], map: "Notice_flatId_fkey")
  house     house?   @relation(fields: [houseId], references: [id], map: "Notice_houseId_fkey")

  @@index([createdBy], map: "Notice_createdBy_fkey")
  @@index([flatId], map: "Notice_flatId_idx")
  @@index([houseId], map: "Notice_houseId_idx")
}

model notification {
  id                  BigInt                @id @default(autoincrement())
  uuid                String                @unique(map: "Notification_uuid_key") @db.VarChar(36)
  userId              BigInt
  title               String
  message             String
  type                String                @default("info")
  read                Boolean               @default(false)
  metadata            String?               @db.LongText
  pushSent            Boolean               @default(false)
  pushError           String?
  createdAt           DateTime              @default(now())
  readAt              DateTime?
  expiresAt           DateTime?
  user                user                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")
  pushnotificationlog pushnotificationlog[]

  @@index([pushSent], map: "Notification_pushSent_idx")
  @@index([type], map: "Notification_type_idx")
  @@index([userId, createdAt], map: "Notification_userId_createdAt_idx")
  @@index([userId, read], map: "Notification_userId_read_idx")
}

model permission {
  id                            BigInt                          @id @default(autoincrement())
  key                           String                          @unique(map: "Permission_key_key")
  description                   String?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime
  caretakerassignmentpermission caretakerassignmentpermission[]
  rolepermission                rolepermission[]
  staffpermission               staffpermission[]
}

model pushnotificationlog {
  id               BigInt            @id @default(autoincrement())
  userId           BigInt
  title            String
  body             String
  data             String?           @db.LongText
  notificationId   BigInt?
  subscriptionId   BigInt?
  sentAt           DateTime          @default(now())
  delivered        Boolean           @default(false)
  deliveredAt      DateTime?
  opened           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  openedAt         DateTime?
  error            String?
  notification     notification?     @relation(fields: [notificationId], references: [id], map: "PushNotificationLog_notificationId_fkey")
  pushsubscription pushsubscription? @relation(fields: [subscriptionId], references: [id], map: "PushNotificationLog_subscriptionId_fkey")
  user             user              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PushNotificationLog_userId_fkey")

  @@index([delivered], map: "PushNotificationLog_delivered_idx")
  @@index([notificationId], map: "PushNotificationLog_notificationId_fkey")
  @@index([subscriptionId], map: "PushNotificationLog_subscriptionId_fkey")
  @@index([userId, sentAt], map: "PushNotificationLog_userId_sentAt_idx")
}

model pushsubscription {
  id                  BigInt                @id @default(autoincrement())
  userId              BigInt
  endpoint            String                @unique(map: "PushSubscription_endpoint_key")
  p256dh              String
  auth                String
  userAgent           String?
  clientType          String?
  createdAt           DateTime              @default(now())
  expiresAt           DateTime?
  lastUsed            DateTime              @default(now())
  pushnotificationlog pushnotificationlog[]
  user                user                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PushSubscription_userId_fkey")

  @@index([userId, clientType], map: "PushSubscription_userId_clientType_idx")
  @@index([userId], map: "PushSubscription_userId_idx")
}

model refreshtoken {
  id        BigInt   @id @default(autoincrement())
  token     String   @unique(map: "RefreshToken_token_key")
  userId    BigInt
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      user     @relation(fields: [userId], references: [id], map: "RefreshToken_userId_fkey")

  @@index([userId], map: "RefreshToken_userId_idx")
}

model registrationtoken {
  id                                     BigInt    @id @default(autoincrement())
  token                                  String    @unique(map: "RegistrationToken_token_key")
  createdBy                              BigInt
  email                                  String?
  roleSlug                               String
  expiresAt                              DateTime
  used                                   Boolean   @default(false)
  usedAt                                 DateTime?
  usedBy                                 BigInt?   @unique(map: "RegistrationToken_usedBy_key")
  metadata                               String?   @db.LongText
  createdAt                              DateTime  @default(now())
  user_registrationtoken_createdByTouser user      @relation("registrationtoken_createdByTouser", fields: [createdBy], references: [id], map: "RegistrationToken_createdBy_fkey")
  user_registrationtoken_usedByTouser    user?     @relation("registrationtoken_usedByTouser", fields: [usedBy], references: [id], map: "RegistrationToken_usedBy_fkey")

  @@index([createdBy], map: "RegistrationToken_createdBy_idx")
  @@index([expiresAt], map: "RegistrationToken_expiresAt_idx")
  @@index([token], map: "RegistrationToken_token_idx")
  @@index([used], map: "RegistrationToken_used_idx")
}

model renter {
  id               BigInt            @id @default(autoincrement())
  uuid             String            @unique(map: "Renter_uuid_key") @db.VarChar(36)
  name             String
  phone            String?
  alternativePhone String?
  email            String?
  nid              String?
  nidFrontImageUrl String?
  nidBackImageUrl  String?
  status           String?           @default("active")
  metadata         String?           @db.LongText
  createdBy        BigInt?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  flat             flat[]
  rent_payments    rent_payment[]
  user             user?             @relation(fields: [createdBy], references: [id], map: "Renter_createdBy_fkey")
  advance_payments advance_payment[]

  @@index([createdBy], map: "Renter_createdBy_fkey")
}

model role {
  id             BigInt           @id @default(autoincrement())
  name           String           @unique(map: "Role_name_key")
  slug           String           @unique(map: "Role_slug_key")
  rank           Int
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  rolepermission rolepermission[]
  user           user[]
  userloginas    userloginas[]
}

model rolelimit {
  id            BigInt   @id @default(autoincrement())
  roleSlug      String   @unique(map: "RoleLimit_roleSlug_key")
  maxHouses     Int      @default(1)
  maxCaretakers Int      @default(2)
  maxFlats      Int      @default(10)
  canLoginAs    String?  @db.LongText
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([roleSlug], map: "RoleLimit_roleSlug_idx")
}

model rolepermission {
  id           BigInt     @id @default(autoincrement())
  roleId       BigInt
  permissionId BigInt
  createdAt    DateTime   @default(now())
  permission   permission @relation(fields: [permissionId], references: [id], map: "RolePermission_permissionId_fkey")
  role         role       @relation(fields: [roleId], references: [id], map: "RolePermission_roleId_fkey")

  @@unique([roleId, permissionId], map: "RolePermission_roleId_permissionId_key")
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model staffpermission {
  id                                   BigInt     @id @default(autoincrement())
  userId                               BigInt
  permissionId                         BigInt
  grantedBy                            BigInt
  grantedAt                            DateTime   @default(now())
  revokedAt                            DateTime?
  revokedBy                            BigInt?
  user_staffpermission_grantedByTouser user       @relation("staffpermission_grantedByTouser", fields: [grantedBy], references: [id], map: "StaffPermission_grantedBy_fkey")
  permission                           permission @relation(fields: [permissionId], references: [id], map: "StaffPermission_permissionId_fkey")
  user_staffpermission_revokedByTouser user?      @relation("staffpermission_revokedByTouser", fields: [revokedBy], references: [id], map: "StaffPermission_revokedBy_fkey")
  user_staffpermission_userIdTouser    user       @relation("staffpermission_userIdTouser", fields: [userId], references: [id], map: "StaffPermission_userId_fkey")

  @@unique([userId, permissionId], map: "StaffPermission_userId_permissionId_key")
  @@index([grantedAt], map: "StaffPermission_grantedAt_idx")
  @@index([grantedBy], map: "StaffPermission_grantedBy_fkey")
  @@index([permissionId], map: "StaffPermission_permissionId_idx")
  @@index([revokedBy], map: "StaffPermission_revokedBy_fkey")
  @@index([userId], map: "StaffPermission_userId_idx")
}

model systemsetting {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique(map: "SystemSetting_key_key")
  value     String   @db.LongText
  type      String   @default("string")
  category  String   @default("general")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([category], map: "SystemSetting_category_idx")
  @@index([key], map: "SystemSetting_key_idx")
}

model template {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique(map: "Template_key_key")
  type      String
  locale    String   @db.VarChar(8)
  subject   String?
  content   String
  createdAt DateTime @default(now())
}

model user {
  id                                                        BigInt                @id @default(autoincrement())
  uuid                                                      String                @unique(map: "User_uuid_key") @db.VarChar(36)
  email                                                     String                @unique(map: "User_email_key") @db.VarChar(255)
  emailVerifiedAt                                           DateTime?
  passwordHash                                              String?               @db.VarChar(255)
  salt                                                      String?               @db.VarChar(64)
  googleId                                                  String?               @unique(map: "User_googleId_key") @db.VarChar(255)
  locale                                                    String                @default("en") @db.VarChar(8)
  name                                                      String?               @db.VarChar(150)
  phone                                                     String?               @unique(map: "User_phone_key") @db.VarChar(50)
  avatarUrl                                                 String?               @db.VarChar(1024)
  profileJson                                               String?               @db.LongText
  roleId                                                    BigInt?
  parentId                                                  BigInt?
  needsPasswordSetup                                        Boolean               @default(false)
  status                                                    String                @default("active")
  lastLoginAt                                               DateTime?
  lastLoginIp                                               String?               @db.VarChar(45)
  metadata                                                  String?               @db.LongText
  createdAt                                                 DateTime              @default(now())
  updatedAt                                                 DateTime
  deletedAt                                                 DateTime?
  app_fee_payments                                          app_fee_payment[]
  caretakerassignment_caretakerassignment_caretakerIdTouser caretakerassignment[] @relation("caretakerassignment_caretakerIdTouser")
  caretakerassignment_caretakerassignment_createdByTouser   caretakerassignment[] @relation("caretakerassignment_createdByTouser")
  device                                                    device[]
  house                                                     house[]
  approved_expenses                                         house_expense[]       @relation("ExpenseApprovedBy")
  paid_expenses                                             house_expense[]       @relation("ExpensePaidBy")
  notice                                                    notice[]
  notification                                              notification[]
  pushnotificationlog                                       pushnotificationlog[]
  pushsubscription                                          pushsubscription[]
  refreshtoken                                              refreshtoken[]
  registrationtoken_registrationtoken_createdByTouser       registrationtoken[]   @relation("registrationtoken_createdByTouser")
  registrationtoken_registrationtoken_usedByTouser          registrationtoken?    @relation("registrationtoken_usedByTouser")
  rent_payments                                             rent_payment[]
  renter                                                    renter[]
  staffpermission_staffpermission_grantedByTouser           staffpermission[]     @relation("staffpermission_grantedByTouser")
  staffpermission_staffpermission_revokedByTouser           staffpermission[]     @relation("staffpermission_revokedByTouser")
  staffpermission_staffpermission_userIdTouser              staffpermission[]     @relation("staffpermission_userIdTouser")
  user                                                      user?                 @relation("userTouser", fields: [parentId], references: [id], map: "User_parentId_fkey")
  other_user                                                user[]                @relation("userTouser")
  role                                                      role?                 @relation(fields: [roleId], references: [id], map: "User_roleId_fkey")
  userloginas_userloginas_targetUserIdTouser                userloginas[]         @relation("userloginas_targetUserIdTouser")
  userloginas_userloginas_userIdTouser                      userloginas[]         @relation("userloginas_userIdTouser")

  caretakerassignmentpermission_caretakerassignmentpermission_grantedByTouser caretakerassignmentpermission[] @relation("caretakerassignmentpermission_grantedByTouser")
  caretakerassignmentpermission_caretakerassignmentpermission_revokedByTouser caretakerassignmentpermission[] @relation("caretakerassignmentpermission_revokedByTouser")

  @@index([email], map: "User_email_idx")
  @@index([parentId], map: "User_parentId_fkey")
  @@index([phone], map: "User_phone_idx")
  @@index([roleId], map: "User_roleId_fkey")
}

model userloginas {
  id                                  BigInt   @id @default(autoincrement())
  userId                              BigInt
  targetUserId                        BigInt
  originalRoleId                      BigInt
  reason                              String?
  createdAt                           DateTime @default(now())
  expiresAt                           DateTime
  role                                role     @relation(fields: [originalRoleId], references: [id], map: "UserLoginAs_originalRoleId_fkey")
  user_userloginas_targetUserIdTouser user     @relation("userloginas_targetUserIdTouser", fields: [targetUserId], references: [id], map: "UserLoginAs_targetUserId_fkey")
  user_userloginas_userIdTouser       user     @relation("userloginas_userIdTouser", fields: [userId], references: [id], map: "UserLoginAs_userId_fkey")

  @@unique([userId, targetUserId], map: "UserLoginAs_userId_targetUserId_key")
  @@index([expiresAt], map: "UserLoginAs_expiresAt_idx")
  @@index([originalRoleId], map: "UserLoginAs_originalRoleId_fkey")
