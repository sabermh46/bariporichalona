# Copy this file to scripts/backup.env and adjust for your cPanel environment.
#   cp scripts/backup.env.example scripts/backup.env
# backup.env is gitignored (it names your DB and paths). Do NOT put the DB
# password here — that lives in ~/.my.cnf (chmod 600). See README-backup.md.

# Database to back up
DB_NAME=baripknex
DB_HOST=localhost

# MySQL credentials file (created once via cPanel File Manager, chmod 600)
MYSQL_DEFAULTS_FILE=$HOME/.my.cnf

# Where dumps are written — MUST be outside public_html (never web-served)
BACKUP_DIR=$HOME/db-backups

# How many daily .sql.gz dumps to keep
KEEP_DAILY=7

# Dated snapshot databases (instant same-server rollback).
# Requires the MySQL user to have CREATE/DROP DATABASE privileges; if it does
# not, the script logs "skipped: no CREATE privilege" and the file dump still
# succeeds. Set to 1 only after confirming the privilege (see README-backup.md).
BACKUP_SNAPSHOT_DB=0
DB_SNAPSHOT_PREFIX=baripknex_bak_
SNAPSHOT_KEEP=7

# Full paths help under cron's minimal PATH. Find them with: which mysqldump mysql
# MYSQLDUMP_BIN=/usr/bin/mysqldump
# MYSQL_BIN=/usr/bin/mysql
